# Copy to .env and add your OpenAI API key. Never commit or share your .env.
MODEL_PROVIDER=openai
MODEL_ID=gpt-6-astra
OPENAI_API_KEY=
DEMO_MODE=false
# Include the original project test hotel records and general guidance.
SAMPLE_KNOWLEDGE=true
PORT=8000
SESSION_TTL_SECONDS=1800
HISTORY_LIMIT=12
RETRIEVAL_THRESHOLD=1.5
PROVIDER_TIMEOUT_SECONDS=45
# Optional. Enables authorized staff access to the local change-request queue.
STAFF_TOKEN=
# Optional fictional-data development only. See README before enabling.
RESERVATION_MODE=disabled
# Optional Mews public sandbox only; never use real guest data.
MEWS_SANDBOX_ENABLED=false
MEWS_CLIENT_TOKEN=
MEWS_ACCESS_TOKEN=
