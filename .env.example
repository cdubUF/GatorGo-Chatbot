# Copy to .env and add your OpenAI API key. Never commit or share your .env.
MODEL_PROVIDER=openai
MODEL_ID=gpt-6-astra
OPENAI_API_KEY=
DEMO_MODE=false
# Include the original project test hotel records and general guidance.
SAMPLE_KNOWLEDGE=true
PORT=8000
SESSION_TTL_SECONDS=1800
HISTORY_LIMIT=12
RETRIEVAL_THRESHOLD=1.5
PROVIDER_TIMEOUT_SECONDS=45
# Optional. Enables authorized staff access to the local change-request queue.
STAFF_TOKEN=
# Optional fictional-data development only. See README before enabling.
RESERVATION_MODE=disabled

# Guest expansion (local only by default)
APP_PROFILE=local
SPEECH_ENABLED=true
SPEECH_MODEL=gpt-4o-transcribe
VOICE_MODEL=gpt-4o-mini-tts
MULTILINGUAL_ENABLED=true
REQUESTS_PER_MINUTE=120
SPEECH_REQUESTS_PER_MINUTE=10
# Cumulative conservative reservations, shared by text and speech, persisted across restarts.
# Set to 0 to disable all paid calls. A retry consumes another reservation.
PROVIDER_BUDGET_USD=10
TEXT_CALL_RESERVE_USD=1
SPEECH_CALL_RESERVE_USD=1
# BUDGET_PATH=data/provider-budget.sqlite3
# Hosted profiles are not deployed by the local launchers.
# TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# GUEST_ORIGINS=

# Interprets venue today/tomorrow and calendar dates.
RESORT_TIMEZONE=America/New_York

# Local-only reservation cutoff; hosted profiles always enforce their configured budget.
LOCAL_BUDGET_CUTOFF=true

# Persistent live voice for the local demo; requires LOCAL_BUDGET_CUTOFF=false.
REALTIME_ENABLED=false
REALTIME_MODEL=gpt-realtime-2.1-mini
